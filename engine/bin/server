#!/usr/bin/env ruby
# frozen_string_literal: true

# Il tavolo in ascolto per il gioco: un thread per client, UNA stanza
# (e un Engine) per partita. L'engine è l'unico a scrivere lo stato
# (deciso 2026-09-11): ogni azione arriva come richiesta di giudizio, e
# solo se passa entra nel giornale della stanza e viene inoltrata all'altro
# client. Il vecchio relay che ripeteva tutto senza leggere non c'è più.
#
#   ruby engine/bin/server [porta]      # default 8788
#
# Il client si collega a  ws://host:8788/engine?room=<stanza>[&seat=<a|b>][&token=<token del posto>]
# (`seat` è una preferenza: il posto lo assegna il tavolo, dal 2026-09-23;
# `token` riprende il proprio posto entro la grazia, dal 2026-10-21)
# Senza `room` (o con `room=`) è la stanza «solo»: partita col bot, un
# tavolo privato per quella connessione (lib/rubyfront/room.rb spiega la differenza).
#
# Dal 2026-10-21 (audit): l'handshake ha scadenza, tetto e Origin ammesse
# (handshake.rb); i frame hanno i loro limiti (websocket.rb); ogni client
# ha una coda d'uscita con uno scrittore (connection.rb), così la stanza
# non scrive mai sul socket dentro il suo lucchetto; connessioni, stanze,
# tentativi d'accesso e messaggi sono contati (rate_limiter.rb); senza
# l'anagrafe delle carte il tavolo NON parte; i tester sono per id.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

# In pipe (npm run all) le righe devono scorrere subito, non a blocchi.
$stdout.sync = true

require "json"
require "socket"
require "securerandom"
require "rubyfront/card_index"
require "rubyfront/room"
require "rubyfront/lobby"
require "rubyfront/progression"
require "rubyfront/account"
require "rubyfront/auth"
require "rubyfront/store"
require "rubyfront/websocket"
require "rubyfront/handshake"
require "rubyfront/connection"
require "rubyfront/rate_limiter"

# In locale le variabili del database stanno in .env.local (le scrive
# `neon link`, il repo le ignora): si leggono qui, senza sovrascrivere
# l'ambiente vero — su Render le mette il servizio. Valori con o senza virgolette.
ENV_LOCAL = File.expand_path("../../.env.local", __dir__)
if File.exist?(ENV_LOCAL)
  File.readlines(ENV_LOCAL, chomp: true).each do |line|
    next if line.strip.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    next if key.nil? || value.nil? || ENV.key?(key)

    ENV[key] = value.strip.delete_prefix('"').delete_suffix('"').delete_prefix("'").delete_suffix("'")
  end
end

PORT = Integer(ARGV[0] || ENV.fetch("PORT", 8788))

def env_int(name, default)
  Integer(ENV.fetch(name, default))
rescue ArgumentError, TypeError
  default
end

def env_list(name, alias_name = nil)
  value = ENV[name].to_s
  value = ENV[alias_name].to_s if value.empty? && alias_name
  value.split(",").map(&:strip).reject(&:empty?)
end

# L'anagrafe delle carte viene dal repo del sito: è il SOLO legame con il
# resto di rubyfront2, e sta qui nel trasporto apposta — quando l'engine
# emigrerà in un repo suo basterà puntare RUBYFRONT_DATA altrove.
# Senza anagrafe il tavolo NON parte (audit RF-028): un arbitro muto non è
# un arbitro. RUBYFRONT_ALLOW_EMPTY_INDEX=1 lo lascia partire lo stesso (prove).
DATA_DIR = ENV["RUBYFRONT_DATA"] || File.expand_path("../../data", __dir__)
CARDS = begin
  Rubyfront::CardIndex.load(DATA_DIR)
rescue StandardError => error
  warn "Anagrafe carte non caricata (#{error.message})."
  {}.freeze
end
if CARDS.empty? && ENV["RUBYFRONT_ALLOW_EMPTY_INDEX"] != "1"
  warn "Senza l'anagrafe delle carte il tavolo non parte (RUBYFRONT_DATA=#{DATA_DIR}). RUBYFRONT_ALLOW_EMPTY_INDEX=1 per forzare."
  exit 1
end
# L'indice dei mazzi (§4): la composizione dichiarata di ogni mazzo.
DECKS = begin
  Rubyfront::CardIndex.load_decks(DATA_DIR, cards: CARDS)
rescue StandardError => error
  warn "Indice dei mazzi non caricato (#{error.message})."
  {}.freeze
end

# La memoria (Neon, lib/rubyfront/store.rb): con DATABASE_URL il tavolo
# ricorda i giocatori e i loro dati; senza, gioca come sempre e l'accesso
# risponde che non c'è memoria. Le tabelle si creano all'avvio, se mancano.
STORE = begin
  store = Rubyfront::Store.from_env
  if store
    store.ensure_schema!
    puts "Memoria collegata (Neon)."
  end
  store
rescue StandardError => error
  warn "Memoria non collegata (#{error.message}): il tavolo gioca senza salvare."
  nil
end

# I mazzi gratuiti (`access: "free"` in data/decks/*.json): si assegnano a
# ogni giocatore al suo accesso. Gli altri arriveranno con l'acquisto.
FREE_DECKS = DECKS.select { |_id, deck| deck[:access] == "free" }.keys.sort.freeze
puts "Mazzi gratuiti: #{FREE_DECKS.join(", ")}." unless FREE_DECKS.empty?

# Gli account di prova (per ID dal 2026-10-21, vuoto di default): i soli con
# gli strumenti di prova al tavolo (Evoca, +1 Flusso, Vinci/Perdi).
TEST_IDS = env_list("RUBYFRONT_TEST_IDS").map(&:to_i).reject(&:zero?).freeze

# Il caso lo tira il tavolo (audit RF-008/RF-009): SecureRandom; con
# RUBYFRONT_SEED un generatore a seme, per le prove dal vivo ripetibili.
DICE = ENV["RUBYFRONT_SEED"].to_s.empty? ? SecureRandom : Random.new(Integer(ENV["RUBYFRONT_SEED"]))
puts "Dadi a seme #{ENV["RUBYFRONT_SEED"]} (solo sviluppo)." unless ENV["RUBYFRONT_SEED"].to_s.empty?

# Le Origin ammesse all'handshake (audit RF-025): vuoto = tutte (sviluppo).
ORIGINS = env_list("RUBYFRONT_ORIGINS", "ALLOWED_ORIGINS").freeze

# I tetti (audit RF-013/RF-015/RF-016/RF-018), con la variabile per le prove.
MAX_CONNECTIONS = env_int("RUBYFRONT_MAX_CONNECTIONS", 2000)
MAX_PER_IP = env_int("RUBYFRONT_MAX_PER_IP", 20)
MAX_ROOMS = env_int("RUBYFRONT_MAX_ROOMS", 500)
SEAT_GRACE_S = env_int("RUBYFRONT_SEAT_GRACE_S", Rubyfront::Room::SEAT_GRACE_S)
SWEEP_S = env_int("RUBYFRONT_SWEEP_S", 15)
PING_S = env_int("RUBYFRONT_PING_S", Rubyfront::Connection::PING_EVERY_S)
MESSAGES_PER_S = env_int("RUBYFRONT_MESSAGES_PER_S", 50)

# I limiti dei tentativi, per chiave (IP, nome, giocatore): [quanti, in quanti secondi].
LIMITS = {
  register: [5, 3600], login: [10, 300], verify: [10, 300], resume: [30, 300], verify_resend: [3, 3600],
  match: [20, 60], connect: [env_int("RUBYFRONT_CONNECTS_PER_MIN", 30), 60], rewards: [20, 3600],
}.freeze
LIMITERS = LIMITS.to_h { |kind, (limit, window)| [kind, Rubyfront::RateLimiter.new(limit: limit, window_s: window)] }.freeze
LIMIT = ->(kind, key) { LIMITERS[kind] ? LIMITERS[kind].allow?(key) : true }

# La progressione dei Rubyfront (2026-09-23): un modulo a parte, fuori dal
# giudizio. Le regole e i livelli da data/progression; il Rubyfront di ogni
# mazzo per assegnare l'esperienza a fine partita a chi lo ha giocato.
PROGRESSION = begin
  Rubyfront::Progression.load(DATA_DIR)
rescue StandardError => error
  puts "Progressione non caricata (#{error.message})."
  nil
end
DECK_RUBYFRONT = DECKS.transform_values { |deck| deck[:rubyfront] }.compact.freeze
puts "Progressione: #{PROGRESSION.card_ids.size} Rubyfront, #{PROGRESSION.rules["thresholds"].size} livelli." if PROGRESSION

# L'accesso (2026-09-22): Google col suo client id (GOOGLE_CLIENT_ID), la
# posta di conferma con Resend (RESEND_API_KEY, MAIL_FROM) e il sito per i
# link (RUBYFRONT_SITE). Senza, Google non è offerto e la posta va sul log.
GOOGLE = Rubyfront::Auth::Google.new(ENV["GOOGLE_CLIENT_ID"].to_s)
MAILER = Rubyfront::Auth::Mailer.new(api_key: ENV["RESEND_API_KEY"].to_s, from: ENV["MAIL_FROM"].to_s, site: ENV["RUBYFRONT_SITE"].to_s)
puts "Accesso: password#{GOOGLE.configured? ? ", Google" : ""}#{MAILER.configured? ? ", posta di conferma attiva" : " (posta di conferma sul log)"}." if STORE

# Le ricompense (decisioni del designer, 2026-10-21): l'esperienza va solo
# ad account con l'email confermata (o Google) QUANDO c'è la posta
# (RUBYFRONT_REQUIRE_VERIFIED=1 lo pretende sempre); le partite col bot
# (stanza «solo») la danno ancora (RUBYFRONT_SOLO_REWARDS=0 la toglie).
REQUIRE_VERIFIED = ENV["RUBYFRONT_REQUIRE_VERIFIED"] == "1" || MAILER.configured?
SOLO_REWARDS = ENV["RUBYFRONT_SOLO_REWARDS"] != "0"

# Il gancio della fine partita, fuori dal lucchetto della stanza: per ogni
# posto con un'identità FISSATA alla partita e un mazzo noto, i punti
# dell'esito al Rubyfront di quel mazzo — una volta per partita e giocatore
# (record_match), con le identità distinte in stanza, confermate se la
# posta lo chiede, e non oltre tanti accrediti l'ora — e a quel client la
# progressione aggiornata (`progress`, con `gained` e `outcome`). Nella
# stanza «solo» l'unico posto con identità è l'umano: il bot non cresce.
# Gli errori di memoria restano a log: la partita è finita comunque.
ON_OVER = lambda do |room, outcome|
  next unless STORE && PROGRESSION && outcome[:rewards]

  seats = outcome[:seats]
  ids = seats.values.map { |seat| seat[:player_id] }
  unless room.solo?
    next unless ids.all? && ids.uniq.size == 2
  end
  seats.each do |seat, who|
    player_id = who[:player_id]
    card = DECK_RUBYFRONT[who[:deck_id].to_s]
    next unless player_id && card && PROGRESSION.known?(card)
    next if REQUIRE_VERIFIED && !who[:verified]
    next unless LIMIT.call(:rewards, "rewards:player:#{player_id}")

    result = if outcome[:winner].nil? then "draw"
             elsif outcome[:winner] == seat then "win"
             else "loss"
             end
    gained = PROGRESSION.points_for(result)
    begin
      next unless STORE.record_match(outcome[:match_id], player_id, card, result, gained)

      row = STORE.add_xp(player_id, card, gained)
      room.reply(seat, { t: "progress", gained: gained, outcome: result }.merge(PROGRESSION.progress_of(card, row)))
    rescue StandardError => error
      warn "esperienza non salvata (#{seat}, #{card}): #{error.message}"
    end
  end
end

# L'Ascesa (2026-09-26, §3.3): quella che spetta a un giocatore col mazzo
# dato — il percorso del Rubyfront del mazzo, dalla memoria, accorciato al
# livello di oggi. Senza giocatore, senza memoria o con un mazzo senza
# progressione: nessuna. La stanza la confronta con quella del `loadDeck`.
ASCENT_FOR = lambda do |player_id, deck_id|
  card = DECK_RUBYFRONT[deck_id.to_s]
  next Rubyfront::Room::ASCENT_ZERO unless player_id && STORE && PROGRESSION && card && PROGRESSION.known?(card)

  row = STORE.rubyfronts_of(player_id).find { |entry| entry[:card] == card }
  PROGRESSION.ascent(card, PROGRESSION.progress_of(card, row)[:path])
end

# Le stanze con nome restano in piedi per un po' anche vuote: chi ricarica
# la pagina ritrova la partita. Passato il tempo, il tavolo si sparecchia.
ROOM_GRACE_S = 10 * 60

ROOMS = {}
ROOMS_LOCK = Mutex.new
CONNECTIONS = Hash.new(0)
CONNECTIONS_LOCK = Mutex.new

def new_room(name, solo:)
  Rubyfront::Room.new(name, cards: CARDS, decks: DECKS, solo: solo, on_over: ON_OVER, random: DICE,
                      rewards: solo ? SOLO_REWARDS : true, seat_grace_s: SEAT_GRACE_S)
end

# La stanza col nome, o nil se le stanze sono al tetto.
def room_for(name)
  ROOMS_LOCK.synchronize do
    return ROOMS[name] if ROOMS.key?(name)
    return nil if ROOMS.size >= MAX_ROOMS

    puts "+ stanza «#{name}»"
    ROOMS[name] = new_room(name, solo: false)
  end
end

# L'atrio della partita casuale (2026-09-23): chi aspetta un avversario
# qualunque si mette in fila dalla connessione «solo»; in due, il tavolo
# apre loro una stanza con un nome libero.
LOBBY = Rubyfront::Lobby.new(
  namer: lambda do
    ROOMS_LOCK.synchronize do
      loop do
        name = Rubyfront::Lobby.random_name
        break name unless ROOMS.key?(name)
      end
    end
  end
)

# Lo sweeper: i posti scaduti (abbandoni), le stanze vuote da troppo, le finestre dei limiti.
def sweep
  after = []
  ROOMS_LOCK.synchronize do
    ROOMS.each_value { |room| after.concat(room.expire) }
    ROOMS.delete_if do |name, room|
      gone = room.empty? && room.emptied_at && Time.now - room.emptied_at > ROOM_GRACE_S
      puts "- stanza «#{name}» sparecchiata" if gone
      gone
    end
  end
  after.each(&:call)
  LIMITERS.each_value(&:sweep)
rescue StandardError => error
  warn "sweep: #{error.message}"
end

def count_connection(ip, delta)
  CONNECTIONS_LOCK.synchronize do
    CONNECTIONS[ip] += delta
    CONNECTIONS.delete(ip) if CONNECTIONS[ip] <= 0
    [CONNECTIONS[ip], CONNECTIONS.values.sum]
  end
end

def courtesy
  open = ROOMS_LOCK.synchronize { ROOMS.count { |_, room| !room.empty? } }
  "Tavolo Rubyfront attivo. Regole collegate: #{Rubyfront::Engine::RULES.size}. Stanze aperte: #{open}\n"
end

def parse(text)
  message = JSON.parse(text)
  message.is_a?(Hash) ? message : nil
rescue JSON::ParserError
  nil
end

# Legge e giudica l'handshake: torna il Result dell'upgrade, o nil dopo aver
# risposto (una GET semplice, o un errore).
def handshake(client)
  peer = client.peeraddr(false)[3] rescue nil
  text = Rubyfront::Handshake.read(client)
  result = Rubyfront::Handshake.parse(text, origins: ORIGINS, peer_ip: peer)
  case result.kind
  when :plain
    client.write(Rubyfront::Handshake.response_plain(courtesy))
    nil
  when :error
    client.write(Rubyfront::Handshake.response_error(result.status, result.reason_en))
    nil
  else
    result
  end
rescue Rubyfront::Handshake::Timeout
  client.write(Rubyfront::Handshake.response_error(408, "handshake too slow")) rescue nil
  nil
rescue Rubyfront::Handshake::TooLong
  client.write(Rubyfront::Handshake.response_error(431, "header too large")) rescue nil
  nil
rescue Rubyfront::Handshake::Closed, IOError, SystemCallError
  nil
end

def serve(client)
  wanted = handshake(client)
  return client.close unless wanted

  ip = wanted.client_ip
  per_ip, total = count_connection(ip, +1)
  begin
    if per_ip > MAX_PER_IP || total > MAX_CONNECTIONS
      client.write(Rubyfront::Handshake.response_error(per_ip > MAX_PER_IP ? 429 : 503, per_ip > MAX_PER_IP ? "too many connections from this address" : "the table is full"))
      return
    end
    unless LIMIT.call(:connect, "connect:ip:#{ip}")
      client.write(Rubyfront::Handshake.response_error(429, "too many connections: slow down"))
      return
    end
    client.write(Rubyfront::Handshake.response_101(wanted.key))
    attend(client, wanted, ip)
  ensure
    count_connection(ip, -1)
  end
rescue EOFError, Errno::ECONNRESET, Errno::EPIPE, IOError
  nil
rescue StandardError => error
  warn "connessione caduta: #{error.class}: #{error.message}"
ensure
  client.close rescue nil
end

# La connessione aperta: la coda d'uscita, la stanza, l'utenza, i messaggi.
def attend(client, wanted, ip)
  connection = Rubyfront::Connection.new(client, ping_every_s: PING_S)
  connection.run_writer
  out = connection.out

  solo = wanted.room.empty?
  room = solo ? new_room("", solo: true) : room_for(wanted.room)
  unless room
    out.call({ t: "refused", code: "rooms_full", reason: "il tavolo è pieno: riprova fra poco", reason_en: "the table is full: try again shortly" })
    connection.close(Rubyfront::WebSocket::CLOSE_POLICY, "rooms full")
    connection.join
    drain(client)
    return
  end
  # Il posto lo assegna il tavolo (2026-09-23): quello chiesto se è libero,
  # se no l'altro; col token (2026-10-21) si riprende il proprio; nella
  # «solo» il client è l'unico seduto e il posto non conta. A stanza piena
  # si avvisa e si chiude.
  seat = room.join(wanted.seat, out, token: wanted.token)
  unless seat
    out.call({ t: "room_full", room: wanted.room })
    connection.close(Rubyfront::WebSocket::CLOSE_NORMAL, "room full")
    connection.join
    drain(client)
    return
  end

  account = Rubyfront::Account.new(STORE, out, free_decks: FREE_DECKS, google: GOOGLE, mailer: MAILER, progression: PROGRESSION,
                                   testers: TEST_IDS, limiter: LIMIT, ip: ip, busy: -> { room.busy?(seat) })
  # Chi siede qui, per il gancio della fine partita: lambda, così vale anche
  # se l'accesso arriva dopo; l'identità si fissa al primo carico del mazzo.
  room.attach(seat, who: -> { account.player&.dig(:id) }, tester: -> { account.tester? }, verified: -> { account.verified? },
                    ascent: ->(deck_id) { ASCENT_FOR.call(account.player&.dig(:id), deck_id) })
  decoder = Rubyfront::WebSocket::Decoder.new
  messages = Rubyfront::RateLimiter.new(limit: MESSAGES_PER_S, window_s: 1)
  begin
    until connection.closed?
      chunk = client.readpartial(16_384)
      decoder.feed(chunk).each do |event, payload, reason|
        case event
        when :fail
          connection.close(payload, reason.to_s)
        when :close
          connection.close(Rubyfront::WebSocket::CLOSE_NORMAL)
        when :ping
          connection.push_frame(Rubyfront::WebSocket.encode_pong(payload))
        when :pong
          connection.pong!
        when :text
          unless messages.allow?("m")
            connection.close(Rubyfront::WebSocket::CLOSE_POLICY, "too many messages")
            next
          end
          message = parse(payload)
          next unless message

          # L'atrio (la fila della partita casuale) si usa dalla «solo»; l'utenza
          # (login, save, load) è della connessione, non della stanza.
          handled = solo && message["t"].to_s.start_with?("match") && LIMIT.call(:match, "match:ip:#{ip}") &&
                    LOBBY.handle(message, out, identity: account.player&.dig(:id))
          next if handled
          next if account.handle(message)

          room.handle(seat, message, out: out).each(&:call)
        end
        break if connection.closed?
      end
    end
  ensure
    LOBBY.cancel(out)
    room.leave(seat, out)
    connection.close unless connection.closed?
    connection.join
    drain(client)
  end
end

# Chiudere con byte ancora da leggere manda un RST e il client perde il
# frame di chiusura: si chiude in scrittura e si aspetta (poco) che chiuda lui.
def drain(client, seconds = 1)
  client.close_write rescue nil
  deadline = Time.now + seconds
  while Time.now < deadline && IO.select([client], nil, nil, 0.2)
    break if client.read_nonblock(16_384, exception: false).nil?
  end
rescue IOError, SystemCallError
  nil
end

server = TCPServer.new(PORT)
puts "Tavolo Rubyfront su ws://localhost:#{PORT}"
puts "Regole collegate: #{Rubyfront::Engine::RULES.size} (#{Rubyfront::Engine::RULES.join("; ")})."
puts "Carte conosciute: #{CARDS.size}. Mazzi: #{DECKS.size}. Tester: #{TEST_IDS.empty? ? "nessuno" : TEST_IDS.join(", ")}. Ctrl+C per fermarlo."

Thread.new do
  loop do
    sleep SWEEP_S
    sweep
  end
end

loop do
  Thread.new(server.accept) { |client| serve(client) }
end
