# Le variabili del tavolo (engine/bin/server) e del proxy (scripts/server.mjs).
# Copia in .env.local (ignorato dal repo) e riempi: i valori veri non si
# scrivono mai nel repo. Su Render le mette il servizio.

# La memoria (Neon): senza, il tavolo gioca senza salvare.
DATABASE_URL=

# L'account di prova per le prove dal vivo (game/scripts): nome e password
# dell'utente `tester` (mai a chiavi, mai in chiaro nel repo).
RUBYFRONT_TEST_USER=tester
RUBYFRONT_TEST_PASSWORD=

# Gli account di prova PER ID (dal 2026-10-21): i soli con gli strumenti di
# prova al tavolo (Evoca, +1 Flusso, Vinci/Perdi). Vuoto = nessuno.
RUBYFRONT_TEST_IDS=

# Le Origin ammesse all'handshake WebSocket (proxy e tavolo). Vuoto = tutte
# (solo in sviluppo). In produzione: https://il-sito,https://altro
RUBYFRONT_ORIGINS=

# I dadi a seme, per le prove ripetibili (SOLO sviluppo). Vuoto = SecureRandom.
RUBYFRONT_SEED=

# L'esperienza solo ad account con l'email confermata (già vero quando la
# posta è configurata); 1 per pretenderlo sempre.
RUBYFRONT_REQUIRE_VERIFIED=

# Le partite col bot danno esperienza (1, di default); 0 per toglierla.
RUBYFRONT_SOLO_REWARDS=

# Far partire il tavolo anche senza l'anagrafe delle carte (SOLO prove).
RUBYFRONT_ALLOW_EMPTY_INDEX=

# I tetti (di norma non servono): connessioni, per indirizzo, stanze, grazia
# del posto in secondi, sweeper, ping, messaggi al secondo.
# RUBYFRONT_MAX_CONNECTIONS=2000
# RUBYFRONT_MAX_PER_IP=20
# RUBYFRONT_MAX_ROOMS=500
# RUBYFRONT_SEAT_GRACE_S=120
# RUBYFRONT_SWEEP_S=15
# RUBYFRONT_PING_S=30
# RUBYFRONT_MESSAGES_PER_S=50

# L'accesso con Google (il client id del bottone) e la posta di conferma (Resend).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
MAIL_FROM=
RUBYFRONT_SITE=
